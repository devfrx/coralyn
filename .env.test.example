# Ambiente delle e2e API. Copia in `.env.test` alla root: `cp .env.test.example .env.test`
#
# ATTENZIONE — il DB indicato qui viene SVUOTATO dalle e2e (gli helper in apps/api/test/helpers/
# fanno deleteMany({}) senza guardia). Il nome DEVE contenere `coralyn_test`: `jest-setup-env.ts`
# lo verifica e rifiuta di avviare la suite altrimenti.
#
# La porta e' 5432, come `docker-compose.yml` versionato. Se sulla tua macchina il DB e' rimappato
# da un `docker-compose.override.yml` locale, allinea qui la porta di conseguenza.

DATABASE_URL="postgresql://coralyn_app:coralyn_app@localhost:5432/coralyn_test?schema=public"

# Valori DEV-ONLY: le e2e non toccano servizi reali (Mailpit e' un catch-all locale).
JWT_SECRET="test-secret-change-me-at-least-32-characters-long"
JWT_EXPIRES_IN="8h"

DEV_ADMIN_EMAIL="admin@coralyn.dev"
DEV_ADMIN_PASSWORD="coralyn-admin"

MAIL_HOST="localhost"
MAIL_PORT="1025"
MAIL_SECURE="false"
MAIL_FROM="Coralyn <no-reply@coralyn.dev>"

APP_WEB_STAFF_URL="http://localhost:5173"
CREDENTIAL_TOKEN_TTL_HOURS="72"

PLATFORM_SUPERUSER_EMAIL="super@coralyn.dev"
PLATFORM_SUPERUSER_PASSWORD="coralyn-super"
