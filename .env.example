DATABASE_URL="postgresql://coralyn_app:coralyn_app@localhost:5432/coralyn_dev?schema=public"
# NODE_ENV="development"   # development | test | production
# PORT="3000"

JWT_SECRET="change-me-please-32+chars-random-secret"
JWT_EXPIRES_IN="8h"
DEV_ADMIN_EMAIL="admin@coralyn.dev"
DEV_ADMIN_PASSWORD="change-me"

# Email (ADR-0042) — invito credenziali via link set-password. In dev punta a Mailpit.
MAIL_HOST="localhost"
MAIL_PORT="1025"
MAIL_SECURE="false"
MAIL_FROM="Coralyn <no-reply@coralyn.dev>"
# MAIL_USER / MAIL_PASS: solo con un provider SMTP autenticato (produzione).

# Origin delle app, usati per costruire i link che finiscono in email e QR.
# Le porte sono quelle FISSE del dev server (vite `strictPort`): staff 5173, platform 5174,
# customer 5175. Con `docker compose --profile full` diventano 8080/8081/8082, ma quel compose
# le passa esplicitamente ai container e non legge questo file.
APP_WEB_STAFF_URL="http://localhost:5173"
# Obbligatoria: è il prefisso del link `/attiva?token=…` nel QR consegnato al bagnante.
# Senza, l'API non parte — prima invece degradava in silenzio producendo un URL relativo,
# cioè un QR inutilizzabile e un token monouso già bruciato.
CUSTOMER_APP_URL="http://localhost:5175"

# Bootstrap del primo superuser di piattaforma (seed env-gated, idempotente)
PLATFORM_SUPERUSER_EMAIL="super@coralyn.dev"
PLATFORM_SUPERUSER_PASSWORD="change-me"

# ---- Facoltative: i valori qui sotto SONO i default del codice, scritti per renderli visibili.
# Decommentare solo per cambiarli.
# CREDENTIAL_TOKEN_TTL_HOURS="72"      # validità del link set-password operatore
# CUSTOMER_JWT_EXPIRES_IN="30m"        # access token del bagnante
# CUSTOMER_REFRESH_TTL_DAYS="120"      # durata della sessione device-bound del bagnante
# CUSTOMER_PIN_MAX_ATTEMPTS="5"        # tentativi PIN prima del blocco dell'enrollment
# CUSTOMER_ENROLLMENT_TTL_HOURS="2160" # validità del QR di attivazione (90 giorni)
# CUSTOMER_THROTTLE_LIMIT="10"         # richieste/minuto su /customer/*
# STAFF_AUTH_THROTTLE_LIMIT="20"       # richieste/minuto sulle rotte pubbliche di /auth
# TRUST_PROXY_HOPS="0"                 # reverse proxy DAVANTI all'API: 0 in locale, 2 in produzione
